{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          { "type": "command", "command": "\"$(git rev-parse --show-toplevel)\"/scripts/check-proposal-approved.sh", "statusMessage": "承認ゲートを確認中" },
          { "type": "command", "command": "\"$(git rev-parse --show-toplevel)\"/scripts/check-credentials.sh", "statusMessage": "認証情報を検査中" }
        ]
      }
    ]
  }
}
